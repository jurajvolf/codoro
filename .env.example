# ==============================================================================
# CODORO — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your own secret values.
# NEVER commit your actual .env file to version control!
# ==============================================================================

# 1. Core Django Security
DJANGO_SECRET_KEY=replace-with-a-long-random-50-char-cryptographic-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,codoro.sk,www.codoro.sk
DJANGO_CSRF_TRUSTED_ORIGINS=https://codoro.sk,https://www.codoro.sk

# 2. Socratic AI Tutor (Google Gemini API)
GEMINI_API_KEY=

# 3. GitHub Auto-Deploy Webhook Verification Secret
GITHUB_WEBHOOK_SECRET=

# 4. Optional Database Override (defaults to SQLite db.sqlite3 in development)
# DATABASE_URL=postgres://user:password@localhost:5432/codoro_db
